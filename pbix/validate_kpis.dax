EVALUATE
UNION (
    ROW ( "Context", "All", "Total Sales", [Total Sales], "Total Profit", [Total Profit], "Total Orders", [Total Orders], "Total Quantity", [Total Quantity], "Line Items", [Line Items], "Profit Margin", [Profit Margin], "Average Order Value", [Average Order Value], "Loss Lines", [Loss Lines], "Loss Line Rate", [Loss Line Rate], "Sales Previous Year", [Sales Previous Year], "Sales YoY %", [Sales YoY %] ),
    CALCULATETABLE ( ROW ( "Context", "2017", "Total Sales", [Total Sales], "Total Profit", [Total Profit], "Total Orders", [Total Orders], "Total Quantity", [Total Quantity], "Line Items", [Line Items], "Profit Margin", [Profit Margin], "Average Order Value", [Average Order Value], "Loss Lines", [Loss Lines], "Loss Line Rate", [Loss Line Rate], "Sales Previous Year", [Sales Previous Year], "Sales YoY %", [Sales YoY %] ), TREATAS ( {2017}, 'Calendar'[Year] ) ),
    CALCULATETABLE ( ROW ( "Context", "2017 West Technology", "Total Sales", [Total Sales], "Total Profit", [Total Profit], "Total Orders", [Total Orders], "Total Quantity", [Total Quantity], "Line Items", [Line Items], "Profit Margin", [Profit Margin], "Average Order Value", [Average Order Value], "Loss Lines", [Loss Lines], "Loss Line Rate", [Loss Line Rate], "Sales Previous Year", [Sales Previous Year], "Sales YoY %", [Sales YoY %] ), TREATAS ( {2017}, 'Calendar'[Year] ), TREATAS ( {"West"}, Sales[Region] ), TREATAS ( {"Technology"}, Sales[Category] ) ),
    CALCULATETABLE ( ROW ( "Context", "2014-01", "Total Sales", [Total Sales], "Total Profit", [Total Profit], "Total Orders", [Total Orders], "Total Quantity", [Total Quantity], "Line Items", [Line Items], "Profit Margin", [Profit Margin], "Average Order Value", [Average Order Value], "Loss Lines", [Loss Lines], "Loss Line Rate", [Loss Line Rate], "Sales Previous Year", [Sales Previous Year], "Sales YoY %", [Sales YoY %] ), TREATAS ( {2014}, 'Calendar'[Year] ), TREATAS ( {"2014-01"}, 'Calendar'[Month] ) ),
    CALCULATETABLE ( ROW ( "Context", "2015-01", "Total Sales", [Total Sales], "Total Profit", [Total Profit], "Total Orders", [Total Orders], "Total Quantity", [Total Quantity], "Line Items", [Line Items], "Profit Margin", [Profit Margin], "Average Order Value", [Average Order Value], "Loss Lines", [Loss Lines], "Loss Line Rate", [Loss Line Rate], "Sales Previous Year", [Sales Previous Year], "Sales YoY %", [Sales YoY %] ), TREATAS ( {2015}, 'Calendar'[Year] ), TREATAS ( {"2015-01"}, 'Calendar'[Month] ) ),
    CALCULATETABLE ( ROW ( "Context", "No rows", "Total Sales", [Total Sales], "Total Profit", [Total Profit], "Total Orders", [Total Orders], "Total Quantity", [Total Quantity], "Line Items", [Line Items], "Profit Margin", [Profit Margin], "Average Order Value", [Average Order Value], "Loss Lines", [Loss Lines], "Loss Line Rate", [Loss Line Rate], "Sales Previous Year", [Sales Previous Year], "Sales YoY %", [Sales YoY %] ), TREATAS ( {2017}, 'Calendar'[Year] ), TREATAS ( {"No such region"}, Sales[Region] ) )
)
