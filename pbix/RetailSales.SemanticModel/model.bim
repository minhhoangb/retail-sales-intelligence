            "sourceColumn": "Discount",
            "summarizeBy": "none"
          },
          {
            "name": "Profit",
            "dataType": "double",
            "formatString": "$#,0.00;($#,0.00);$0.00",
            "lineageTag": "2db6d8bf-0b8d-4880-8972-2679cd3c87fa",
            "sourceColumn": "Profit",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "71f6f819-0ee9-435d-945a-3871714497ff",
        "measures": [
          {
            "name": "Total Sales",
            "description": "Tổng doanh thu trong ngữ cảnh lọc hiện tại.",
            "displayFolder": "KPI",
            "expression": "SUM ( Sales[Sales] )",
            "formatString": "$#,0.00;($#,0.00);$0.00",
            "lineageTag": "21630127-7166-4ba7-a390-0f6ca668ea87"
          },
          {
            "name": "Total Profit",
            "description": "Tổng lợi nhuận, giữ cả giao dịch lỗ.",
            "displayFolder": "KPI",
            "expression": "SUM ( Sales[Profit] )",
            "formatString": "$#,0.00;($#,0.00);$0.00",
            "lineageTag": "d0a0e832-2782-431b-bf05-fe103e244ca9"
          },
          {
            "name": "Total Orders",
            "description": "Số Order ID khác nhau trong ngữ cảnh lọc; một đơn có thể có nhiều mặt hàng.",
            "displayFolder": "KPI",
            "expression": "DISTINCTCOUNT ( Sales[Order ID] )",
            "formatString": "#,0",
            "lineageTag": "e8e44bf7-bbc5-4ba6-a4a5-53b39bf20d16"
          },
          {
            "name": "Total Quantity",
            "description": "Tổng số lượng sản phẩm bán ra.",
            "displayFolder": "KPI",
            "expression": "SUM ( Sales[Quantity] )",
            "formatString": "#,0",
            "lineageTag": "52ca512b-570b-4820-8f89-c29c9766c336"
          },
          {
            "name": "Line Items",
            "description": "Số dòng mặt hàng; không phải số đơn hàng.",
            "displayFolder": "KPI",
            "expression": "COUNTROWS ( Sales )",
            "formatString": "#,0",
            "lineageTag": "da403158-7817-42d1-93d5-556d2efddd89"
          },
          {
            "name": "Profit Margin",
            "description": "Biên lợi nhuận = tổng lợi nhuận / tổng doanh thu; không lấy trung bình biên theo dòng.",
            "displayFolder": "KPI",
            "expression": "DIVIDE ( [Total Profit], [Total Sales] )",
            "formatString": "0.00%;(0.00%);0.00%",
            "lineageTag": "5219f8cc-3ca0-4bc8-84df-f7861e77c9a8"
          },
          {
            "name": "Average Order Value",
            "description": "Doanh thu của các mặt hàng được lọc / số đơn chứa các mặt hàng đó; không tính toàn bộ giỏ hàng ngoài bộ lọc.",
            "displayFolder": "KPI",
            "expression": "DIVIDE ( [Total Sales], [Total Orders] )",
            "formatString": "$#,0.00;($#,0.00);$0.00",
            "lineageTag": "583272bc-acbf-48bc-9242-14e4d761e7f2"
          },
          {
            "name": "Loss Lines",
            "description": "Số dòng mặt hàng có lợi nhuận âm; trả 0 khi không có dòng lỗ.",
            "displayFolder": "KPI",
            "expression": "COALESCE ( COUNTROWS ( FILTER ( Sales, Sales[Profit] < 0 ) ), 0 )",
            "formatString": "#,0",
            "lineageTag": "eb3a4b3a-0038-49cc-a5df-e42bb7dea697"
          },
          {
            "name": "Loss Line Rate",
            "description": "Tỷ lệ dòng mặt hàng lỗ; không phải tỷ lệ đơn hàng lỗ.",
            "displayFolder": "KPI",
            "expression": "DIVIDE ( [Loss Lines], [Line Items] )",
            "formatString": "0.00%;(0.00%);0.00%",
            "lineageTag": "96d674f3-c385-4d37-bb2a-76cd6550faa5"
          },
          {
            "name": "Sales Previous Year",
            "description": "Doanh thu cùng kỳ năm trước; chỉ trả kết quả khi chọn đúng một năm hoặc một tháng. Trả BLANK khi thiếu lịch sử hoặc chọn nhiều năm.",
            "displayFolder": "KPI",
            "expression": "IF ( HASONEVALUE ( 'Calendar'[Year] ), CALCULATE ( [Total Sales], DATEADD ( 'Calendar'[Date], -1, YEAR ) ) )",
            "formatString": "$#,0.00;($#,0.00);$0.00",
            "lineageTag": "25272f06-6f9f-43d3-abaf-1bb60e3eec17"
          },
          {
            "name": "Sales YoY %",
            "description": "Tăng trưởng doanh thu cùng kỳ; BLANK khi kỳ hiện tại/kỳ trước thiếu dữ liệu hoặc mẫu số bằng 0.",
            "displayFolder": "KPI",
            "expression": "VAR PriorSales = [Sales Previous Year]\nVAR CurrentSales = [Total Sales]\nRETURN IF ( ISBLANK ( CurrentSales ) || ISBLANK ( PriorSales ), BLANK (), DIVIDE ( CurrentSales - PriorSales, PriorSales ) )",
            "formatString": "0.00%;(0.00%);0.00%",
            "lineageTag": "72539dca-43bf-41ed-8a45-8b752d17676f"
          }
        ],
        "partitions": [
          {
            "name": "Sales",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(ProjectRoot & \"\\data_cleaned\\superstore_clean.csv\"), [Delimiter=\",\", Columns=21, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"Row ID\", Int64.Type}, {\"Order ID\", type text}, {\"Order Date\", type date}, {\"Ship Date\", type date}, {\"Ship Mode\", type text}, {\"Customer ID\", type text}, {\"Customer Name\", type text}, {\"Segment\", type text}, {\"Country\", type text}, {\"City\", type text}, {\"State\", type text}, {\"Postal Code\", type text}, {\"Region\", type text}, {\"Product ID\", type text}, {\"Category\", type text}, {\"Sub-Category\", type text}, {\"Product Name\", type text}, {\"Sales\", type number}, {\"Quantity\", Int64.Type}, {\"Discount\", type number}, {\"Profit\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "Calendar",
        "columns": [
          {
            "name": "Date",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ],
            "dataType": "dateTime",
            "formatString": "yyyy-MM-dd",
            "isKey": true,
            "lineageTag": "3926f3b3-c5f1-4907-9a86-adcbed373f63",
            "sourceColumn": "Date",
            "summarizeBy": "none"
          },
          {
            "name": "Year",
            "dataType": "int64",
            "formatString": "0",
            "lineageTag": "5a0b0c1a-b69c-47db-9cb5-a9ae62e78c9e",
            "sourceColumn": "Year",
            "summarizeBy": "none"
          },
          {
            "name": "Month",
            "dataType": "string",
            "lineageTag": "ab3154c9-35c6-4786-a0fd-4d13e2c08d41",
            "sourceColumn": "Month",
            "summarizeBy": "none"
          }
        ],
        "dataCategory": "Time",
        "lineageTag": "5f223246-136e-432d-b050-8ed867e39df8",
        "partitions": [
          {
            "name": "Calendar",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Start = #date(2014, 1, 1),",
                "    End = #date(2017, 12, 31),",
                "    Dates = Table.FromList(List.Dates(Start, Duration.Days(End - Start) + 1, #duration(1,0,0,0)), Splitter.SplitByNothing(), {\"Date\"}),",
                "    Typed = Table.TransformColumnTypes(Dates, {{\"Date\", type date}}),",
                "    Year = Table.AddColumn(Typed, \"Year\", each Date.Year([Date]), Int64.Type),",
                "    Month = Table.AddColumn(Year, \"Month\", each Date.ToText([Date], \"yyyy-MM\", \"en-US\"), type text)",
                "in",
                "    Month"
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
}
